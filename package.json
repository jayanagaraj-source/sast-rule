{
  "name": "caseflow",
  "private": true,
  "version": "3.14.0",
  "description": "Multi-tenant customer support and case management platform (synthetic SAST benchmark application)",
  "workspaces": ["apps/api", "apps/web-react", "apps/widget-vue", "apps/portal-angular", "apps/worker"],
